# Auth0 settings for the frontend (roadmap step 7a).
#
# Copy this file to `.env.local` (git-ignored) and fill in the three values from
# your Auth0 dashboard. Web App/docs/auth_spec.md §3 walks through creating them
# from scratch, click by click.
#
# Leave them blank and the app runs in BYPASS mode: a fake local user, an amber
# warning strip, and no real login. That is the intended state until a tenant
# exists — it keeps the app and the browser-driven checks in scripts/ working.

# Applications -> your SPA -> Settings -> Domain
VITE_AUTH0_DOMAIN=
# Applications -> your SPA -> Settings -> Client ID
VITE_AUTH0_CLIENT_ID=
# APIs -> your API -> Identifier. Must be byte-identical to AUTH0_AUDIENCE in
# the repository-root .env, which configures the backend and the pdf-service.
VITE_AUTH0_AUDIENCE=

# Force bypass even when the three values above are set. This is what
# scripts/autosave_check.mjs and scripts/phase_b_run.mjs need once Auth0 is
# configured, because Google and Auth0's hosted login both block automated
# sign-in. Ignored entirely in a production build.
# VITE_AUTH_BYPASS=1
